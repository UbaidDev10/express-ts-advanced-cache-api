									"var responseTime = pm.response.responseTime;",
									"",
									"if (status === 429) {",
									"    console.log('Request 1: RATE LIMITED (429) - Response Time:', responseTime, 'ms');",
									"    pm.test('Rate limit triggered', function() {",
									"        pm.expect(status).to.equal(429);",
									"    });",
									"} else {",
									"    console.log('Request 1: SUCCESS (200) - Response Time:', responseTime, 'ms');",
